{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mike-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-16",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only the preview API runs code; every other path is a static file.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // The live "Try Mike" preview: 20 messages a minute per IP address (a campus
  // shares one, so not lower). NVIDIA's own limit on the key is ~40 a minute.
  "ratelimits": [
    {
      "name": "CHAT_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
  // Secret (never in this file): npx wrangler secret put NVIDIA_API_KEY
}
